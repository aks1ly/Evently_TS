section.order-confirmation
    h2.order-confirmation__title Перевірте ваше замовлення

    .order-confirmation__content

        // Ліва колонка
        .order-confirmation__left

            // Параметри заходу
            .order-confirmation__card
                .order-confirmation__card-heading
                    h3 Параметри заходу
                    a(href="/order.html") Редагувати

                .order-confirmation__parameters
                    span Тип заходу
                    span#confirmEventType —

                    span Дата і час
                    span#confirmDateTime —

                    span Місто проведення
                    span#confirmCity —

                    span Кількість гостей
                    span#confirmGuests —

                    span Бюджет
                    span#confirmBudget —

            // Локація
            .order-confirmation__card
                .order-confirmation__card-heading
                    h3 Локація
                    a(href="/order-location.html") Редагувати

                .order-confirmation__location#confirmLocation
                    p Завантаження локації…

            // Послуги
            .order-confirmation__card
                .order-confirmation__card-heading
                    h3 Послуги
                    a(href="/order-services.html") Редагувати
                .order-confirmation__services#confirmServices
                    p Завантаження послуг…

        // Права колонка
        .order-confirmation__right

            // Розрахунок
            .order-confirmation__summary
                h3 Попередній розрахунок:

                .order-confirmation__summary-row
                    span Локація
                    span#confirmLocationPrice —

                .order-confirmation__summary-row
                    span Послуги
                    span#confirmServicesPrice —

                .order-confirmation__total
                    h3 ЗАГАЛЬНА ВАРТІСТЬ:
                    strong#confirmTotal —

            // Контактні дані
            form.order-confirmation__form(id="confirmationForm")
                h3 Ваші контактні дані:

                label(for="confirmationEmail") Введіть пошту для підтвердження замовлення:

                input#confirmationEmail(
                    type="email"
                    name="email"
                    placeholder="example@gmail.com"
                    required
                )

                label(for="confirmationPhone") Введіть номер телефону, щоб ми могли зв’язатись з вами:

                input#confirmationPhone(
                    type="tel"
                    name="phone"
                    placeholder="+380"
                    required
                )

                label.order-confirmation__agreement
                    input(type="checkbox" name="agreement" checked required)
                    span Я погоджуюся на обробку персональних даних відповідно до Політики конфіденційності.

                button.order-confirmation__button(type="submit") Підтвердити замовлення
                include ../components/order-success.pug
    .evently-confirm-modal#confirmBudgetModal(hidden role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle")
        .evently-confirm-modal__panel
            h2#confirmModalTitle Бюджет перевищено!
            p#confirmBudgetMessage
            .evently-confirm-modal__actions
                button#confirmModalClose(type="button") Зрозуміло
                a(href="/order.html") Змінити бюджет
