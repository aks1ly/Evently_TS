include mixins.pug
section.order-locations
    .order-locations__content

        aside.order-locations__filters
            h2.order-locations__heading Тип локації

            .order-locations__options
                each type, index in ["Ресторан", "Банкетний зал", "Заміський комплекс", "Лофт", "Відкрита територія", "Інше"]
                    label.order-locations__checkbox
                        input(type="checkbox" name="locationType" value=["restaurant", "banquet", "country", "loft", "outdoor", "other"][index] )
                        span= type

            .order-locations__price
                .order-locations__price-heading
                    h2 Діапазон цін оренди
                    span Орієнтовна ціна

                .order-locations__range
                    input(type="range" id="minPriceRange" min="10000" max="50000" value="10000" step="1000")
                    input(type="range" id="maxPriceRange" min="10000" max="50000" value="50000" step="1000")

                .order-locations__limits
                    span 10 000
                    span 50 000

                .order-locations__price-fields
                    label Від
                        .order-locations__price-input
                            input(type="number" id="minPrice" value="10000" min="10000")
                            span грн

                    label до
                        .order-locations__price-input
                            input(type="number" id="maxPrice" value="50000" min="10000")
                            span грн

            h2.order-locations__heading Додатково

            .order-locations__options
                each option, index in ["Дитяча зона", "Власний кейтеринг", "Паркування"]
                    label.order-locations__checkbox
                        input(type="checkbox" name="features" value=["kids", "catering", "parking"][index])
                        span= option

        .order-locations__results
            p.order-locations__count#locationsCount(aria-live="polite")
            .order-locations__list#locationsList(aria-live="polite")
                p.order-locations__status#locationStatus Завантаження локацій...
