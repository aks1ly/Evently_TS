section.order-services
	.order-services__layout
		aside.order-services__sidebar
			h2.order-services__sidebar-title Категорії послуг
			.order-services__categories
				button.order-services__category.order-services__category--active(type="button" data-service-tab="host" aria-pressed="true")
					img(src="/images/service-microphone.png" data-icon-default="/images/service-microphone.png" data-icon-active="/images/service-microphone-active.png" alt="")
					span Ведучі
				button.order-services__category(type="button" data-service-tab="photographer" aria-pressed="false")
					img(src="/images/service-camera.png" data-icon-default="/images/service-camera.png" data-icon-active="/images/service-camera-active.png" alt="")
					span Фотографи
				button.order-services__category(type="button" data-service-tab="catering" aria-pressed="false")
					img(src="/images/service-catering-icon.png" data-icon-default="/images/service-catering-icon.png" data-icon-active="/images/service-catering-icon-active.png" alt="")
					span Кейтеринг
		.order-services__main
			p.order-services__status#servicesStatus Завантаження послуг...
			.order-services__catalog#servicesCatalog
			.order-services__summary
				.order-services__selected
					h2.order-services__selected-title#servicesSelectedTitle Обрані послуги (0)
					.order-services__selected-list#servicesSelectedList
				.order-services__checkout
					.order-services__total
						h2 Загальна вартість послуг:
						strong#servicesTotal 0 грн
					a.order-services__next(href="/order-confirmation.html") Далі →
